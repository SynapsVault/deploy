# =============================================================================
# .env.example — Environment Variables Template
# =============================================================================
# Copy this file to `.env` and fill in real values:
#
#     cp .env.example .env
#
# This file consolidates the variables consumed by docker-compose.yml and the
# application services. For the canonical, up-to-date list of every supported
# variable (including optional/advanced ones), see:
#
#     docs/ENVIRONMENT-VARIABLES.md
#
# NOTE: Never commit a real `.env` file. The values below are safe placeholders
#       and MUST be replaced before running in any non-local environment.
# =============================================================================


# -----------------------------------------------------------------------------
# General / Runtime
# -----------------------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=info
PORT=3000


# -----------------------------------------------------------------------------
# Database (PostgreSQL)
# -----------------------------------------------------------------------------
# DATABASE_URL is the connection string used by the backend services.
DATABASE_URL=postgresql://postgres:postgres@db:5432/app

# Individual Postgres settings consumed by the `db` service in docker-compose.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=app
POSTGRES_HOST=db
POSTGRES_PORT=5432


# -----------------------------------------------------------------------------
# Stellar / Soroban
# -----------------------------------------------------------------------------
# Network: `testnet` | `mainnet` | `futurenet` | `local`
STELLAR_NETWORK=testnet
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
STELLAR_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# Secret key of the account used to sign transactions.
# Use a throwaway key for local development only.
STELLAR_SECRET_KEY=SXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Public key corresponding to STELLAR_SECRET_KEY.
STELLAR_PUBLIC_KEY=GXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Deployed contract IDs (fill in after deploying contracts).
STELLAR_CONTRACT_ID=CXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX


# -----------------------------------------------------------------------------
# Supabase
# -----------------------------------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key


# -----------------------------------------------------------------------------
# API / Admin
# -----------------------------------------------------------------------------
# Shared secret required by admin-only endpoints. Generate a strong random value.
ADMIN_API_KEY=change-me-to-a-long-random-string

# Base URL the frontend uses to reach the API.
VITE_API_URL=http://localhost:3000


# -----------------------------------------------------------------------------
# Frontend (Vite)
# -----------------------------------------------------------------------------
# Vite only exposes variables prefixed with VITE_ to the client bundle.
VITE_APP_NAME=StellarApp
VITE_STELLAR_NETWORK=testnet
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key


# -----------------------------------------------------------------------------
# Docker Compose (optional overrides)
# -----------------------------------------------------------------------------
# Host ports exposed by docker-compose. Change if they conflict locally.
API_PORT=3000
DB_PORT=5432
WEB_PORT=5173